// Configuración de Cloudflare para VD Noticias.
// Guía paso a paso: docs/PUBLICAR-EN-CLOUDFLARE.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vd-noticias",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Base de datos del periódico (artículos, usuarios, publicidad, etc.).
  // Crea la base con:  npx wrangler d1 create vd-noticias-db
  // y pega aquí el "database_id" que devuelve ese comando.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vd-noticias-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  // Fotos y videos subidos desde la sala de redacción.
  // Crea el bucket con:  npx wrangler r2 bucket create vd-noticias-media
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "vd-noticias-media"
    }
  ],

  // Optimización de imágenes (/_vinext/image).
  "images": { "binding": "IMAGES" },

  "vars": {
    // Cambia esto por tu dominio cuando lo conectes, p. ej. https://vdnoticias.com
    "NEXT_PUBLIC_SITE_URL": "https://vd-noticias.miguelitosuarez112004.workers.dev",
    "EDITORIAL_OWNER_EMAIL": "propietario@vdnoticias.do"
  }
  // EDITORIAL_OWNER_PASSWORD NO va aquí. Se configura como secreto:
  //   npx wrangler secret put EDITORIAL_OWNER_PASSWORD
}
